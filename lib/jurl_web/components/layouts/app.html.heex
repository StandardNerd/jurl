<header class="px-6 py-6 border-b border-line bg-base">
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-6">
      <a href="/" class="font-serif text-2xl font-bold tracking-tight text-ink hover:text-accent">
        JURL<span class="text-accent">.</span>
      </a>
      <span class="text-xs text-faded uppercase tracking-wider font-mono">Minimal URL Shortener</span>
    </div>
  </div>
</header>

<main class="py-8 bg-base">
  <div class="mx-auto px-4 sm:px-6 lg:px-8">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
